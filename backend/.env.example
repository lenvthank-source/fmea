# Backend Environment Variables Template
PORT=3000
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET="your-secure-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

