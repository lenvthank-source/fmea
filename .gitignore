# Root configurations and deployment templates (track required infra)
/package.json
!/package.json
/fmea-pod.yaml
!fmea-pod.yaml
/*.yaml
!docker-compose*.yaml
/*.yml
/podman_deployment_guide.md

# Documentation & Specifications
!/docs/**
/docs/assets/legacy_icons/

# Ignore all subfolder README.md files (except root, docs, and .agents)
**/README.md
!/README.md
!/docs/README.md
!/.agents/README.md
!/.agents/**/README.md
!/backend/README.md
!/frontend/README.md


# Runtime diagnostics and temporary graph locks
/backend/local-api.*.log
graphify-out/.rebuild.lock

# Maintainable source/migration directory indexes
!/backend/src/**/README.md
!/backend/prisma/**/README.md
!/backend/scripts/README.md
!/backend/test/README.md
!/frontend/src/**/README.md
